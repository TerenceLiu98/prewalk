{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/prewalk_pause.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(functions\\.)?(update_plan|todo)$",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/prewalk_todo_tracker.sh",
            "timeout": 30,
            "statusMessage": "prewalk todo tracker"
          }
        ]
      },
      {
        "matcher": "^(functions\\.)?(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/prewalk_edit_tracker.sh",
            "timeout": 30,
            "statusMessage": "prewalk edit tracker"
          }
        ]
      }
    ]
  }
}
